# Sim Sim settings template. Copy this file to .env and fill in YOUR values there. Never commit .env.
# (Built from the names the code reads — no real values here.)

# The Meta Model API key: the ONLY brain. Server-side only. Empty = the stub reply "Meta brain not connected yet."
META_API_KEY=
# Optional: which Meta chat model to use (empty = muse-spark-1.3).
META_MODEL=
# Full path to the Firebase service-account JSON file — keep that file OUTSIDE this folder.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternative to the path above, for a hosted copy that can't read the laptop's secrets folder: the service-account
# key's JSON pasted straight in (one line). If set, it is used INSTEAD of the path above. Leave empty on the laptop.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Saved logins key (32 random bytes, base64); make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=
# Test mode, for our own testing only: exactly 1 = no sign-in, everyone is one built-in local user.
SIMSIM_TEST_MODE=
# Dev door, build phase only: exactly 1 = sign in by typing an email, no verification. Leave empty before submission.
SIMSIM_DEV_DOOR=
# Preview lock, for a TEMPORARY private online preview only — never set on the founder's laptop. When set, only
# this one email (any case) may hold a session; every other email, through every door, gets "This preview is
# private." and zero data. Leave empty for the public launch.
PREVIEW_ONLY_EMAIL=
# Optional: the port the server listens on (empty = 3000).
PORT=

# Sim Sim's MOUTH (designed voices, ElevenLabs text-to-speech). Server-side only. Empty = the browser's own voice.
VOICE_API_KEY=
# Optional: the ElevenLabs speech model (empty = eleven_flash_v2_5).
VOICE_TTS_MODEL=
